  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                oss.id,\n                oss.organization_id,\n                o.name as organization_name,\n                oss.last_sync_at,\n                oss.last_version,\n                oss.last_external_version,\n                oss.status,\n                oss.total_entries,\n                oss.last_job_id,\n                oss.last_error\n            FROM organization_sync_status oss\n            JOIN organizations o ON o.id = oss.organization_id\n            ORDER BY oss.updated_at DESC\n            ",
